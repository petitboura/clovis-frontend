# Même backend que djiguigne-frontend (brief section 1 : "réutilise les
# endpoints existants côté backend").
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Requis par app/layout.tsx pour résoudre les URLs absolues (OG, etc.),
# et par le bouton partager (AppSidebar.tsx/EspacePlus.tsx) pour construire
# le lien de téléchargement partagé. Public (préfixe NEXT_PUBLIC_) depuis
# le 31/08 : renommé depuis APP_URL (privé), qui empêchait le bouton
# partager de lire la valeur côté navigateur -- sur Vercel, la créer en
# type "Configuration", pas "Secrète" (une variable NEXT_PUBLIC_ ne peut
# pas être secrète, elle est exposée au navigateur par définition).
NEXT_PUBLIC_APP_URL=http://localhost:3000
