<?xml version="1.0" encoding="utf-8"?>
<!--
    Cree le 25/08/2026, Bourama : flavor "externe" (distribution hors Play
    Store). Point d'ancrage pose au Lot 3C (fusion Capacitor, initialement
    vide en attendant la migration du service d'accessibilite), rempli au
    Lot 3B (lots 6-7 portes depuis clovis-mobile/android-legacy-natif) avec
    la declaration reelle du service d'accessibilite, sans changement de
    logique (voir ServiceAccessibiliteClovis.kt).
    31/08/2026 : ajout du bloc <queries> (visibilite des paquets, Android
    11+) pour que ResolveurApps.listerAppsInstallees() (nouveau selecteur
    d'apps du plugin Accessibilite) voie les autres apps lancables. Portee
    au flavor "externe" uniquement, car c'est le seul a exposer cette
    methode (le stub "play" la rejette sans jamais l'appeler reellement).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".accessibilite.ServiceAccessibiliteClovis"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="Clovis, lecture d'écran">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
