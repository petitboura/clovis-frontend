# Lot 3C (Phase 3, fusion Capacitor).
# COPIE ce fichier en "keystore.properties" (sans ".example") dans ce meme
# dossier, remplis les vraies valeurs, ne le committe JAMAIS : il est
# ignore explicitement (voir android/.gitignore).
#
# IMPORTANT : si une cle de signature "externe" a deja ete generee pour
# clovis-mobile/android-legacy-natif (voir
# clovis-mobile/android-legacy-natif/README-SIGNATURE.md), c'est CETTE MEME
# cle (meme .jks) qui doit etre referencee ici, jamais une nouvelle. Sinon,
# aucune mise a jour ne pourra s'installer par-dessus une app "externe" deja
# installee chez un etudiant a partir de l'ancien socle natif. Pas encore
# confirme avec Bourama a ce jour (25/08/2026) -- a trancher avant toute
# generation d'APK signe.

storeFile=/chemin/absolu/vers/clovis-mobile-release.jks
storePassword=CHANGE_MOI
keyAlias=clovis-mobile
keyPassword=CHANGE_MOI
